#!/usr/bin/env bash
#
# Root-owned transactional updater, triggered by inkpanel-update.path when the
# unprivileged application creates /opt/inkpanel/data/.update-requested.
#
# Never replace this file from the app-owned checkout. Git, npm and firmware
# commands run as inkpanel; root only controls systemd and moves/snapshots data.

set -Eeuo pipefail

APP=inkpanel
APP_DIR=/opt/inkpanel
REPO_DIR="$APP_DIR/app"
DATA_DIR="$APP_DIR/data"
CONFIG_FILE="$DATA_DIR/config.json"
FIRMWARE_DIST="$REPO_DIR/firmware/dist"
ENV_FILE="$APP_DIR/inkpanel.env"
FLAG="$DATA_DIR/.update-requested"
STATUS="$DATA_DIR/update-status.json"
TRANSACTION_ROOT=/var/lib/inkpanel-update
HEALTH_MAX_ATTEMPTS=45
HEALTH_TIMEOUT_SECONDS=45
HEALTH_REQUIRED_CONSECUTIVE=3

LOG_FILE="$(mktemp)"
STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The status writer runs unprivileged, so give its group deliberate read-only
# access to this root-owned log. Keeping root ownership matters: the app cannot
# replace the log pathname and redirect later root appends through a symlink.
chown "root:$APP" "$LOG_FILE"
chmod 640 "$LOG_FILE"

FINALIZED=0
ROLLBACK_IN_PROGRESS=0
COMMIT_BEFORE=""
COMMIT_AFTER=""
TRANSACTION_DIR=""
DEPS_STAGE=""
DEPS_OLD=""
DEPS_OLD_MODE=755
DEPS_CHANGED=0
DEPS_SWAPPED=0
LIVE_DEPS_EXISTED=0
CONFIG_SNAPSHOTTED=0
CONFIG_EXISTED=0
CONFIG_MODE=600
FIRMWARE_SNAPSHOTTED=0
FIRMWARE_EXISTED=0
FIRMWARE_REPLACED=0
FIRMWARE_STAGE=""
SERVICE_STOPPED=0
CANDIDATE_STARTED=0
HEALTH_PORT=8080
HEALTH_URL=""

# Clear the request first so the path unit re-arms after this invocation.
rm -f "$FLAG"

write_status() {
  runuser -u "$APP" -- node "$SCRIPT_DIR/write-status.mjs" \
    "$1" "${2:-}" "$LOG_FILE" "$STATUS" "$STARTED_AT"
  if [[ "$1" == "success" || "$1" == "failed" ]]; then FINALIZED=1; fi
}

log() { printf '%s\n' "$*" >>"$LOG_FILE"; }

remove_path() {
  local path="$1"
  [[ -n "$path" && "$path" != "/" ]] || return 1
  rm -rf -- "$path"
}

cleanup_artifacts() {
  if [[ -n "$FIRMWARE_STAGE" && -e "$FIRMWARE_STAGE" ]]; then
    runuser -u "$APP" -- rm -rf -- "$FIRMWARE_STAGE" || true
  fi
  if [[ -n "$DEPS_STAGE" && -e "$DEPS_STAGE" ]]; then remove_path "$DEPS_STAGE" || true; fi
  if [[ -n "$DEPS_OLD" && -e "$DEPS_OLD" ]]; then remove_path "$DEPS_OLD" || true; fi
  if [[ -n "$TRANSACTION_DIR" && -e "$TRANSACTION_DIR" ]]; then
    remove_path "$TRANSACTION_DIR" || true
  fi
}

on_exit() {
  if [[ "$FINALIZED" -eq 0 ]]; then
    log "update interrupted before a terminal state; rollback artifacts were retained"
    write_status failed "update was interrupted before it finished; manual inspection may be required" || true
  fi
  rm -f "$LOG_FILE"
}
trap on_exit EXIT

resolve_health_port() {
  local line value port_number
  HEALTH_PORT=8080
  if [[ -f "$ENV_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      if [[ "$line" =~ ^[[:space:]]*PORT[[:space:]]*= ]]; then
        value="${line#*=}"
        value="${value%%#*}"
        value="${value//[[:space:]]/}"
        if [[ ! "$value" =~ ^[0-9]+$ || ${#value} -gt 5 ]]; then
          log "invalid PORT entry in $ENV_FILE"
          return 1
        fi
        port_number=$((10#$value))
        if (( port_number < 1 || port_number > 65535 )); then
          log "PORT is outside the TCP range: $value"
          return 1
        fi
        HEALTH_PORT="$port_number"
      fi
    done <"$ENV_FILE"
  fi
  HEALTH_URL="http://127.0.0.1:${HEALTH_PORT}/health"
}

probe_health_once() {
  local http_code
  systemctl is-active --quiet "${APP}.service" || return 1
  http_code="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --connect-timeout 2 --max-time 3 "$HEALTH_URL" 2>>"$LOG_FILE" || true)"
  [[ "$http_code" == "200" ]]
}

health_probation() {
  local label="$1" attempt consecutive=0 deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS))
  for ((attempt = 1; attempt <= HEALTH_MAX_ATTEMPTS; attempt += 1)); do
    if probe_health_once; then
      consecutive=$((consecutive + 1))
      log "$label health probe $attempt: healthy ($consecutive/$HEALTH_REQUIRED_CONSECUTIVE consecutive)"
      if (( consecutive >= HEALTH_REQUIRED_CONSECUTIVE )); then return 0; fi
    else
      consecutive=0
      log "$label health probe $attempt: unhealthy"
    fi
    if (( SECONDS >= deadline )); then
      log "$label health probation reached its ${HEALTH_TIMEOUT_SECONDS}s deadline"
      break
    fi
    sleep 1
  done
  return 1
}

current_head() {
  runuser -u "$APP" -- git rev-parse --verify HEAD 2>/dev/null || true
}

dependency_inputs() {
  local commit="$1" path blob
  for path in package.json package-lock.json; do
    blob="$(runuser -u "$APP" -- git rev-parse --verify "${commit}:${path}" 2>/dev/null || true)"
    printf '%s=%s\n' "$path" "${blob:-missing}"
  done
}

restore_dependencies() {
  local ok=0
  [[ "$DEPS_SWAPPED" -eq 1 ]] || return 0
  log "rollback: restoring previous node_modules"
  remove_path "$REPO_DIR/node_modules" || ok=1
  if [[ "$LIVE_DEPS_EXISTED" -eq 1 ]]; then
    if [[ -n "$DEPS_OLD" && -d "$DEPS_OLD" ]]; then
      mv -- "$DEPS_OLD" "$REPO_DIR/node_modules" || ok=1
      chown "$APP:$APP" "$REPO_DIR/node_modules" || ok=1
      chmod "$DEPS_OLD_MODE" "$REPO_DIR/node_modules" || ok=1
      DEPS_OLD=""
    else
      log "rollback: previous node_modules snapshot is missing"
      ok=1
    fi
  fi
  return "$ok"
}

restore_config() {
  local ok=0
  [[ "$CONFIG_SNAPSHOTTED" -eq 1 ]] || return 0
  log "rollback: restoring config.json baseline"
  rm -f -- "$CONFIG_FILE" || ok=1
  if [[ "$CONFIG_EXISTED" -eq 1 ]]; then
    if [[ -f "$TRANSACTION_DIR/config.json" ]]; then
      install -o "$APP" -g "$APP" -m "$CONFIG_MODE" \
        "$TRANSACTION_DIR/config.json" "$CONFIG_FILE" || ok=1
    else
      log "rollback: config.json snapshot is missing"
      ok=1
    fi
  fi
  return "$ok"
}

restore_firmware() {
  local ok=0 restore_stage=""
  [[ "$FIRMWARE_REPLACED" -eq 1 ]] || return 0
  log "rollback: restoring previous firmware/dist package"
  if [[ ! -d "$REPO_DIR" || -L "$REPO_DIR" ]]; then
    log "rollback: refusing firmware restore because checkout root is not a real directory"
    return 1
  fi
  if [[ "$FIRMWARE_EXISTED" -eq 1 ]]; then
    if [[ -L "$TRANSACTION_DIR/firmware-snapshot" || \
          -e "$TRANSACTION_DIR/firmware-snapshot" ]]; then
      restore_stage="$REPO_DIR/.firmware-restore.$(basename "$TRANSACTION_DIR")"
      # Root only renames the protected snapshot object into the validated
      # checkout root. It never traverses app-controlled snapshot contents.
      mv -T -- "$TRANSACTION_DIR/firmware-snapshot" "$restore_stage" || return 1
      runuser -u "$APP" -- rm -rf -- "$FIRMWARE_DIST" || ok=1
      runuser -u "$APP" -- mkdir -p -- "$REPO_DIR/firmware" || ok=1
      runuser -u "$APP" -- mv -- "$restore_stage/firmware-dist" "$FIRMWARE_DIST" \
        || ok=1
      runuser -u "$APP" -- rmdir -- "$restore_stage" || ok=1
    else
      log "rollback: firmware/dist snapshot is missing"
      ok=1
    fi
  else
    runuser -u "$APP" -- rm -rf -- "$FIRMWARE_DIST" || ok=1
  fi
  return "$ok"
}

abort_update() {
  local reason="$1" rollback_needed=0 rollback_ok=1 head_now message
  if [[ "$ROLLBACK_IN_PROGRESS" -eq 1 ]]; then return 1; fi
  ROLLBACK_IN_PROGRESS=1
  trap - ERR INT TERM
  set +e
  log "candidate update failed: $reason"

  head_now="$(current_head)"
  if [[ -n "$COMMIT_BEFORE" && "$head_now" != "$COMMIT_BEFORE" ]]; then rollback_needed=1; fi
  if [[ "$DEPS_SWAPPED" -eq 1 || "$CONFIG_SNAPSHOTTED" -eq 1 || \
        "$FIRMWARE_REPLACED" -eq 1 || "$SERVICE_STOPPED" -eq 1 || \
        "$CANDIDATE_STARTED" -eq 1 ]]; then rollback_needed=1; fi

  if [[ "$rollback_needed" -eq 0 ]]; then
    message="update failed before deployment changes: $reason"
    cleanup_artifacts
    write_status failed "$message"
    echo "inkpanel-update: FAILED — $message" >&2
    exit 1
  fi

  write_status running "candidate failed; automatic rollback in progress"
  log "== automatic rollback =="

  if [[ "$SERVICE_STOPPED" -eq 1 || "$CANDIDATE_STARTED" -eq 1 ]]; then
    systemctl stop "${APP}.service" >>"$LOG_FILE" 2>&1 || rollback_ok=0
  fi

  if [[ -n "$COMMIT_BEFORE" ]]; then
    log "rollback: resetting checkout to $COMMIT_BEFORE"
    runuser -u "$APP" -- git reset --hard "$COMMIT_BEFORE" >>"$LOG_FILE" 2>&1 || rollback_ok=0
  fi

  restore_dependencies || rollback_ok=0
  restore_config || rollback_ok=0
  restore_firmware || rollback_ok=0

  if [[ "$SERVICE_STOPPED" -eq 1 || "$CANDIDATE_STARTED" -eq 1 ]]; then
    systemctl start "${APP}.service" >>"$LOG_FILE" 2>&1 || rollback_ok=0
  fi

  if ! health_probation "rollback"; then rollback_ok=0; fi

  if [[ "$rollback_ok" -eq 1 ]]; then
    message="candidate update failed: $reason; automatic rollback succeeded; rolled back to $COMMIT_BEFORE"
    cleanup_artifacts
  else
    message="update failed and automatic rollback did not recover InkPanel; manual intervention required"
    log "rollback artifacts retained at: ${TRANSACTION_DIR:-not created}"
  fi
  write_status failed "$message"
  echo "inkpanel-update: FAILED — $message" >&2
  exit 1
}

on_error() {
  local line="$1" status="$2"
  abort_update "unexpected error on line $line (exit $status)"
}
trap 'on_error "$LINENO" "$?"' ERR
trap 'abort_update "update was interrupted by a signal"' INT TERM

write_status running
mkdir -p "$TRANSACTION_ROOT"
chown root:root "$TRANSACTION_ROOT"
chmod 700 "$TRANSACTION_ROOT"
TRANSACTION_DIR="$(mktemp -d "$TRANSACTION_ROOT/transaction.XXXXXX")"
chmod 700 "$TRANSACTION_DIR"

cd "$REPO_DIR"

TRACKED_CHANGES="$(runuser -u "$APP" -- git status --porcelain --untracked-files=no)"
if [[ -n "$TRACKED_CHANGES" ]]; then
  log "tracked working tree/index changes detected:"
  log "$TRACKED_CHANGES"
  abort_update "tracked local modifications exist; refusing to update"
fi

COMMIT_BEFORE="$(current_head)"
if [[ ! "$COMMIT_BEFORE" =~ ^[0-9a-f]{40}$ ]]; then
  abort_update "could not capture the current Git commit"
fi
DEPENDENCY_INPUTS_BEFORE="$(dependency_inputs "$COMMIT_BEFORE")"
log "rollback baseline commit: $COMMIT_BEFORE"
log "dependency inputs before: $DEPENDENCY_INPUTS_BEFORE"

if ! resolve_health_port; then
  abort_update "invalid PORT in $ENV_FILE"
fi
log "== preflight health ($HEALTH_URL) =="
if ! probe_health_once; then
  abort_update "current InkPanel service is not healthy; no update was attempted"
fi
log "preflight health: ok"
write_status running

log "== git pull =="
if ! runuser -u "$APP" -- git pull --ff-only origin main >>"$LOG_FILE" 2>&1; then
  COMMIT_AFTER="$(current_head)"
  abort_update "git pull failed"
fi
COMMIT_AFTER="$(current_head)"
if [[ ! "$COMMIT_AFTER" =~ ^[0-9a-f]{40}$ ]]; then
  abort_update "could not capture the candidate Git commit"
fi
log "candidate commit: $COMMIT_AFTER"
write_status running

# Never install a new privileged helper from this app-owned checkout. Existing
# LXCs require an explicit administrator refresh of /usr/local/bin/inkpanel-update.

DEPENDENCY_INPUTS_AFTER="$(dependency_inputs "$COMMIT_AFTER")"
log "dependency inputs after: $DEPENDENCY_INPUTS_AFTER"
if [[ "$DEPENDENCY_INPUTS_BEFORE" != "$DEPENDENCY_INPUTS_AFTER" ]]; then
  DEPS_CHANGED=1
  log "== stage production dependencies =="
  DEPS_STAGE="$(runuser -u "$APP" -- mktemp -d "$REPO_DIR/.dependency-stage.XXXXXX")"
  runuser -u "$APP" -- cp package.json package-lock.json "$DEPS_STAGE/" \
    >>"$LOG_FILE" 2>&1 || abort_update "could not prepare dependency staging inputs"
  if [[ -f .npmrc ]]; then
    runuser -u "$APP" -- cp .npmrc "$DEPS_STAGE/" >>"$LOG_FILE" 2>&1 \
      || abort_update "could not copy candidate npm configuration"
  fi
  runuser -u "$APP" -- npm ci --omit=dev --prefix "$DEPS_STAGE" \
    >>"$LOG_FILE" 2>&1 || abort_update "candidate dependency staging failed"
  if [[ ! -d "$DEPS_STAGE/node_modules" ]]; then
    abort_update "candidate dependency staging produced no node_modules"
  fi
  log "dependency staging: ok"
else
  log "== dependency staging skipped (inputs unchanged) =="
fi
write_status running

FIRMWARE_DIFF="$(runuser -u "$APP" -- git diff --name-only "$COMMIT_BEFORE" "$COMMIT_AFTER" -- \
  firmware/ scripts/build-firmware.sh scripts/firmware-manifest.mjs \
  scripts/firmware-input-hash.sh 2>/dev/null || true)"
HAVE_FIRMWARE_HASH=0
CURRENT_FIRMWARE_HASH=""
BUILT_FIRMWARE_HASH=""
if [[ -f ./scripts/firmware-input-hash.sh ]]; then
  CURRENT_FIRMWARE_HASH="$(runuser -u "$APP" -- bash ./scripts/firmware-input-hash.sh \
    2>>"$LOG_FILE" || true)"
  if [[ -n "$CURRENT_FIRMWARE_HASH" ]]; then
    HAVE_FIRMWARE_HASH=1
    BUILT_FIRMWARE_HASH="$(cat firmware/dist/input.sha256 2>/dev/null | tr -d '[:space:]' || true)"
  fi
fi

NEEDS_FIRMWARE_BUILD=0
if [[ "$HAVE_FIRMWARE_HASH" -eq 1 ]]; then
  [[ "$CURRENT_FIRMWARE_HASH" == "$BUILT_FIRMWARE_HASH" ]] || NEEDS_FIRMWARE_BUILD=1
elif [[ -n "$FIRMWARE_DIFF" ]]; then
  NEEDS_FIRMWARE_BUILD=1
fi

if [[ "$NEEDS_FIRMWARE_BUILD" -eq 1 ]]; then
  if [[ -n "$FIRMWARE_DIFF" ]]; then
    log "== firmware rebuild (firmware inputs changed) =="
  elif [[ "$HAVE_FIRMWARE_HASH" -eq 1 && -z "$BUILT_FIRMWARE_HASH" ]]; then
    log "== firmware rebuild (no freshness stamp / legacy build) =="
  else
    log "== firmware rebuild (served build is stale) =="
    log "current inputs: $CURRENT_FIRMWARE_HASH"
    log "served build:   $BUILT_FIRMWARE_HASH"
  fi
  FIRMWARE_SNAPSHOTTED=1
  if [[ -e "$FIRMWARE_DIST" ]]; then
    FIRMWARE_EXISTED=1
    FIRMWARE_STAGE="$(runuser -u "$APP" -- mktemp -d "$REPO_DIR/.firmware-snapshot.XXXXXX")"
    runuser -u "$APP" -- cp -a -- "$FIRMWARE_DIST" "$FIRMWARE_STAGE/firmware-dist" \
      || abort_update "could not snapshot previous firmware package as inkpanel"
    # Move the staging object itself. Root must not resolve a child through an
    # app-controlled intermediate directory, even if that directory is raced.
    mv -- "$FIRMWARE_STAGE" "$TRANSACTION_DIR/firmware-snapshot" \
      || abort_update "could not protect previous firmware package"
    FIRMWARE_STAGE=""
  fi
  if runuser -u "$APP" -- ./scripts/build-firmware.sh >>"$LOG_FILE" 2>&1; then
    FIRMWARE_REPLACED=1
    log "firmware rebuild: ok"
  else
    log "firmware rebuild: FAILED — previous successful package remains served; server update continues"
  fi
else
  log "== firmware rebuild skipped (served package is fresh) =="
fi
write_status running

log "== deploy candidate =="
if ! systemctl stop "${APP}.service" >>"$LOG_FILE" 2>&1; then
  abort_update "could not stop InkPanel cleanly"
fi
SERVICE_STOPPED=1

if [[ -e "$CONFIG_FILE" ]]; then
  CONFIG_EXISTED=1
  CONFIG_MODE="$(runuser -u "$APP" -- stat -c '%a' "$CONFIG_FILE" 2>/dev/null || printf '600')"
  [[ "$CONFIG_MODE" =~ ^[0-7]{3,4}$ ]] || CONFIG_MODE=600
  if ! runuser -u "$APP" -- cat "$CONFIG_FILE" >"$TRANSACTION_DIR/config.json"; then
    abort_update "could not snapshot config.json after stopping the service"
  fi
else
  log "config.json baseline: absent"
fi
CONFIG_SNAPSHOTTED=1

if [[ "$DEPS_CHANGED" -eq 1 ]]; then
  DEPS_OLD="$TRANSACTION_DIR/node_modules.before"
  if [[ -e "$REPO_DIR/node_modules" ]]; then
    LIVE_DEPS_EXISTED=1
    DEPS_OLD_MODE="$(runuser -u "$APP" -- stat -c '%a' "$REPO_DIR/node_modules" \
      2>/dev/null || printf '755')"
    [[ "$DEPS_OLD_MODE" =~ ^[0-7]{3,4}$ ]] || DEPS_OLD_MODE=755
    mv -- "$REPO_DIR/node_modules" "$DEPS_OLD" \
      || abort_update "could not preserve live node_modules"
    DEPS_SWAPPED=1
    chown root:root "$DEPS_OLD" \
      || abort_update "could not protect previous node_modules ownership"
    chmod 700 "$DEPS_OLD" \
      || abort_update "could not protect previous node_modules permissions"
    log "previous dependencies protected at $DEPS_OLD"
  fi
  DEPS_SWAPPED=1
  mv -- "$DEPS_STAGE/node_modules" "$REPO_DIR/node_modules" \
    || abort_update "could not activate staged node_modules"
  remove_path "$DEPS_STAGE"
  DEPS_STAGE=""
  log "staged dependencies activated"
fi

if ! systemctl start "${APP}.service" >>"$LOG_FILE" 2>&1; then
  abort_update "candidate service did not start"
fi
CANDIDATE_STARTED=1
SERVICE_STOPPED=0
write_status running

log "== candidate health probation ($HEALTH_URL) =="
if ! health_probation "candidate"; then
  abort_update "candidate failed health probation"
fi

log "candidate health probation: passed"
cleanup_artifacts
write_status success
echo "inkpanel-update: candidate $COMMIT_AFTER is healthy"
